# Copy this file to .env and adjust for your MySQL server
PORT=3000

# Option A: one connection URI (e.g. the Aiven "Service URI")
# DATABASE_URL=mysql://avnadmin:password@mysql-xxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Option B: individual settings

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=covid_vaccination
# Set to true for cloud MySQL providers that require SSL (Aiven, TiDB Cloud, etc.)
DB_SSL=false

# Any long random string; used to sign session cookies
SESSION_SECRET=change-this-to-a-long-random-string
